# ================== 服务配置 ==================
HOST=0.0.0.0
PORT=8000

# ================== Ollama LLM ==================
OLLAMA_HOST=http://localhost:11434
# ================== LLM 提供商 ==================
LLM_PROVIDER=ollama
# 远程 OpenAI 兼容(切换 provider=openai 时用):
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_REMOTE_MODEL=
LLM_REMOTE_TOOL_MODEL=
# 主模型（回复生成，支持多模态）
LLM_MODEL=qwen3.5:9b
# 工具/抽取/情感分析模型
TOOL_LLM_MODEL=qwen2.5:7b
# 采样温度（角色扮演：略高有活气；0.0-1.0，越低越稳定）
LLM_TEMPERATURE=0.85

# ================== 百度搜索 API（可选） ==================
BAIDU_API_KEY=
BAIDU_API_SECRET=

# ================== 嵌入模型 ==================
# 嵌入模式：ollama（nomic-embed-text，推荐）/ local（本地 sentence-transformers）
EMBEDDING_MODE=ollama
# 本地嵌入模型路径（EMBEDDING_MODE=local 时使用）
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2
# Ollama 嵌入模型（EMBEDDING_MODE=ollama 时使用，需已 pull）
OLLAMA_EMBED_MODEL=nomic-embed-text

# ================== 重排序（Cross-Encoder） ==================
# 是否启用重排序（需要本地 ONNX 模型 + onnxruntime）
ENABLE_RERANK=true
# 重排器后端：bge（BAAI/bge-reranker-v2-m3，中文友好，默认）/ minilm（旧 ms-marco，英文场景）
RERANKER_BACKEND=bge
# BGE reranker 目录（含 model.onnx + tokenizer.json + config.json）
BGE_RERANKER_DIR=models/bge-reranker-v2-m3
# BGE ONNX 文件名（默认 model.onnx）
BGE_RERANKER_ONNX=model.onnx
# 旧 MS-MARCO reranker 路径（保留）
CROSS_ENCODER_ONNX_PATH=models/ms-marco-MiniLM-L-6-v2/ms-marco-MiniLM-L-6-v2.onnx

# ================== 记忆系统 ==================
# L1 内存上下文最大轮数（超限自动压缩为摘要）
MEMORY_CONTEXT_MAX_ROUNDS=50
# L2 短期记忆保留轮数（FIFO 淘汰）
MEMORY_SHORT_TERM_MAX_ROUNDS=50
# L4 事实重要性阈值（0-1，高于此值才抽取为长期事实）
MEMORY_IMPORTANCE_THRESHOLD=0.6
# L4 事实衰减周期（天）
MEMORY_FACT_DECAY_DAYS=90
# 调试输出
MEMORY_DEBUG=false

# ================== L3 主动信息池 ==================
# 是否启用 L3（外部信息采集 + 主动推送）
L3_ENABLED=false
# 采集周期（秒）
L3_UPDATE_INTERVAL=7200
# 推送周期（秒）
L3_PUSH_INTERVAL=300
# 采集关键词（逗号分隔，如 天气,人工智能,二次元）
L3_KEYWORDS=天气,今日热点,二次元话题
# L3 池最大条目数
L3_MAX_ITEMS=200
# 练习提醒 / 感知层 / 关系记忆 等配置参考 README（以下为本示例的补充说明）

# ================== 感知层 ==================
# 是否启用感知层（时序/系统/情境/作息/情绪趋势）
PERCEPTION_ENABLED=true
PERCEPTION_CITY=
# 情绪趋势保留样本数 / 作息活跃窗口天数
MOOD_TREND_MAX_SAMPLES=200
ROUTINE_WINDOW_DAYS=30
# 感知 prompt 总字符上限（超此限制时按优先级裁剪低价值项，防止撑爆 system prompt）
PERCEPTION_PROMPT_MAX_CHARS=500
# 系统启动时刻缓存 TTL（秒）：避免每轮感知都花约 4s 查 PowerShell（运行时长仍实时换算）
PERCEPTION_SYSTEM_CACHE_TTL=300

# ================== 环境感知工具（LLM 主动查询） ==================
# 总开关：注册并对 LLM 暴露“当前浏览器标签页 / 前台窗口 / 感知摘要”工具（默认 true）。
ENVIRONMENT_SENSING_ENABLED=true
# ---- 工具组内每个工具可单独开关（默认均 true） ----
# 标签页感知（读当前浏览器标签）
BROWSER_TAB_SENSING_ENABLED=true
# 前台窗口感知（Windows 原生 GetForegroundWindow）
FOREGROUND_SENSING_ENABLED=true
# 感知摘要工具（get_perception_summary）
PERCEPTION_SUMMARY_SENSING_ENABLED=true
# Chrome/Edge 远程调试端口（需以 --remote-debugging-port=此端口 启动浏览器）
BROWSER_DEBUG_PORT=9222
# 浏览器 CDP 请求超时（秒）
BROWSER_SENSING_TIMEOUT=3
# 标签页标题最多保留字符数
MAX_TAB_TITLE_CHARS=40
FOREGROUND_SENSING_TIMEOUT=2
# 感知→表达触发对齐：前台/标签页变化时给低频提示
SENSING_TRIGGER_ENABLED=true
# 滚动帧趋势感知：内存保留最近 N 帧环境快照（前台/标签页），用于说出"你刚才从 X 切到 Y"（0=关）
SENSING_FRAME_WINDOW=8
# ================== 本地视觉感知（Ollama多模态 → 文本描述） ==================
# 让纯文本主模型"间接看图"：本地 Ollama 视觉模型把图/屏幕转成中文描述后注入主模型。
# 默认全关：本地无视觉模型时不影响既有行为。
VISION_ENABLED=false
# 本地 Ollama 视觉模型名（如 qwen2.5-vl:7b / minicpm-v / llama3.2-vision:11b）
VISION_MODEL=qwen2.5-vl:7b
# 场景 A：对话中识别用户发的图片
VISION_IN_CHAT=true
# 场景 B：桌面窗口识别（感知层"电脑当前活跃"的补充；默认关）
VISION_SCREEN_ON_DEMAND=false
# 视觉模型推断超时（秒）
VISION_TIMEOUT=20

# ================== 主动性心跳（低频、克制的主动开口） ==================
# 总开关：默认关闭（避免打扰）。开启后由 ProactiveDecider 综合信号决定是否主动。
PROACTIVITY_ENABLED=false
# 主动最小间隔（分钟） / 每日主动次数上限（0=不限）
PROACTIVITY_MIN_INTERVAL_MIN=30
PROACTIVITY_DAILY_CAP=8

# ================== 关系记忆内核（底层内在状态层） ==================
# 关系记忆 JSON 持久化文件（与 ChromaDB 解耦，避免嵌入调用）
RELATION_MEMORY_FILE=relation_memory.json
# 是否启用关系记忆内核（共同经历账本 / 情绪衰减 / 周期反思）
RELATION_MEMORY_ENABLED=true
# 情绪/好感度/经历随时间衰减的半衰期（天）；0=不衰减
RELATION_EMOTION_HALFLIFE_DAYS=21
# 写入共同经历账本所需的最小情绪共振（0-1）；低于此的日常闲聊不写入
RELATION_EPISODE_RESONANCE_THRESHOLD=0.55
# 周期反思启动间隔（秒）；0=禁用后台自动反思
RELATION_REFLECT_INTERVAL=3600
# 单次反思最多处理多少条候选经历
RELATION_REFLECT_BATCH=20

# ================== 提醒/日程 ==================
# 提醒调度扫描间隔（秒）
REMINDER_SCAN_INTERVAL=15
REMINDER_FILE=reminders.json
