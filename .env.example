# ================== 服务配置 ==================
HOST=0.0.0.0
PORT=8000

# ================== Ollama LLM ==================
OLLAMA_HOST=http://localhost:11434
# 主模型（回复生成，支持多模态）
LLM_MODEL=qwen3.5:9b
# 工具/抽取/情感分析模型
TOOL_LLM_MODEL=qwen2.5:7b

# ================== 百度搜索 API（可选） ==================
BAIDU_API_KEY=
BAIDU_API_SECRET=

# ================== 嵌入模型 ==================
# 嵌入模式：ollama（nomic-embed-text，推荐）/ local（本地 sentence-transformers）
EMBEDDING_MODE=ollama
# 本地嵌入模型路径（EMBEDDING_MODE=local 时使用）
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2
# Ollama 嵌入模型（EMBEDDING_MODE=ollama 时使用，需已 pull）
OLLAMA_EMBED_MODEL=nomic-embed-text

# ================== 重排序（Cross-Encoder） ==================
# 是否启用重排序（需要本地 ONNX 模型 + onnxruntime）
ENABLE_RERANK=true
# 重排器后端：bge（BAAI/bge-reranker-v2-m3，中文友好，默认）/ minilm（旧 ms-marco，英文场景）
RERANKER_BACKEND=bge
# BGE reranker 目录（含 model.onnx + tokenizer.json + config.json）
BGE_RERANKER_DIR=models/bge-reranker-v2-m3
# BGE ONNX 文件名（默认 model.onnx）
BGE_RERANKER_ONNX=model.onnx
# 旧 MS-MARCO reranker 路径（保留）
CROSS_ENCODER_ONNX_PATH=models/ms-marco-MiniLM-L-6-v2/ms-marco-MiniLM-L-6-v2.onnx

# ================== 记忆系统 ==================
# L1 内存上下文最大轮数（超限自动压缩为摘要）
MEMORY_CONTEXT_MAX_ROUNDS=50
# L2 短期记忆保留轮数（FIFO 淘汰）
MEMORY_SHORT_TERM_MAX_ROUNDS=50
# L4 事实重要性阈值（0-1，高于此值才抽取为长期事实）
MEMORY_IMPORTANCE_THRESHOLD=0.6
# L4 事实衰减周期（天）
MEMORY_FACT_DECAY_DAYS=90
# 调试输出
MEMORY_DEBUG=false

# ================== L3 主动信息池（可暂不实现） ==================
L3_UPDATE_INTERVAL=7200
L3_PUSH_INTERVAL=300
